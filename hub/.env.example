# Nunchi 허브 설정 예시 — 이 파일을 .env 로 복사해서 고치세요 (cp .env.example .env)
# 모든 값은 같은 이름의 환경변수로도 바꿀 수 있어요. 예) NUNCHI_LLM_MODEL=gemma4:e2b nunchi serve

# ── 저장 위치 ─────────────────────────────────────────────
NUNCHI_DATA_DIR=~/nunchi                # 지식베이스(index.sqlite3), 인증서 등

# ── Ollama (모든 모델의 엔진) ──────────────────────────────
NUNCHI_OLLAMA_URL=http://127.0.0.1:11434
NUNCHI_KEEP_ALIVE=30m                   # 모델을 메모리에 붙잡아 두는 시간 (첫 질문 지연 감소)

# ── 답변 LLM ──────────────────────────────────────────────
NUNCHI_LLM_BACKEND=ollama               # ollama | openai (llama.cpp, LM Studio, mlx_lm 등 OpenAI 호환 서버)
NUNCHI_LLM_MODEL=gemma4:e4b             # 맥은 gemma4:e4b-mlx 가 있으면 자동으로 사용
# NUNCHI_LLM_URL=http://127.0.0.1:8080/v1   # openai 백엔드일 때
NUNCHI_VISION_MODEL=                    # 비우면 LLM과 같은 모델
NUNCHI_VISION_CAPTION=true              # 사진 질문: 캡션→검색 (이게 뭐야? 대응)
NUNCHI_TEMPERATURE=0.3
NUNCHI_MAX_TOKENS=384                   # 음성 답은 짧게
NUNCHI_THINK=false                      # 사고 모드 (수학엔 좋지만 느림)

# ── 검색 (RAG) ────────────────────────────────────────────
NUNCHI_EMBED_MODEL=bge-m3               # 바꾸면: nunchi ingest <폴더> --reembed
NUNCHI_EMBED_QUERY_PREFIX=              # qwen3-embedding 등 지시문이 필요한 모델용
NUNCHI_RETRIEVAL_MODE=hybrid            # hybrid | bm25 | dense
NUNCHI_TOP_K=4
NUNCHI_CHUNK_CHARS=600
NUNCHI_CHUNK_OVERLAP=120
NUNCHI_STRICT_RAG=false                 # true: 문서에 없는 질문엔 답하지 않음
NUNCHI_NUMBER_LOOKUP=true               # "5번 문제"·"3단계"처럼 번호로 물으면 같은 번호 제목의 절을 통째로 가져옴
NUNCHI_MAX_SECTION_CHARS=6000           # 번호 조회로 가져올 절의 최대 글자 수
NUNCHI_LOOKUP_EXCLUSIVE=true            # 번호 조회가 되면 그 절만 답의 근거로 (false: 다른 검색 결과도 함께)

# ── 음성 인식 (STT) ───────────────────────────────────────
NUNCHI_STT_BACKEND=openai               # openai(=Ollama /v1/audio/transcriptions) | whispercpp | none
NUNCHI_STT_MODEL=                       # 비우면 LLM과 같은 모델 (모델 교체 대기 없음)
NUNCHI_STT_LANGUAGE=ko
NUNCHI_STT_PROMPT=                      # 고유명사 힌트 (모델에 따라 반영 정도가 다름)
NUNCHI_AUDIO_PREPROCESS=true            # 무음 자르기·볼륨 정규화

# ── 음성 합성 (TTS, 선택) ─────────────────────────────────
NUNCHI_TTS_BACKEND=auto                 # auto | openai | say | none(폰이 읽기 — 가장 빠름)
NUNCHI_TTS_MODEL=lfm3-audio:2b
NUNCHI_TTS_VOICE=female-korean          # 또는 male-korean
NUNCHI_SAY_VOICE=Yuna                   # macOS say 목소리

# ── 대화 ──────────────────────────────────────────────────
NUNCHI_ANSWER_STYLE=voice               # voice(짧게, 말하듯) | text(화면용, 인용 번호)
NUNCHI_HISTORY_TURNS=3

# ── 서버 ──────────────────────────────────────────────────
NUNCHI_HOST=127.0.0.1                   # 폰에서 접속하려면 0.0.0.0 (토큰 꼭!)
NUNCHI_PORT=8765
NUNCHI_TOKEN=                           # 비어 있지 않으면 모든 API에 Authorization: Bearer <토큰> 필요
NUNCHI_ALLOW_UPLOAD=true
